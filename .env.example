# Meta Model API (dev.meta.ai) — Spark + Voice Transcribe
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
STT_MODEL=muse-voice-transcribe-1.0
# Optional: Meta's open-weight Muse Spark Open on Baseten (partner inference) classifies her intent first;
# Spark 1.3 answers if it fails. Leave the URL empty to use Spark 1.3 only.
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
# SAM 3.1 (same key) outlines the sign in her camera frame — a highlight, never a direction. false = no boxes.
SAM_ENABLED=true

# WhatsApp Business Cloud API (developers.facebook.com → app → WhatsApp → Step 1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v25.0

# Text-to-speech: a Meta open-weight voice served from modal/ — SeamlessM4T v2 (modal deploy modal/seamless_tts.py,
# 200 speakers, pick a soft one with TTS_SPEAKER) or MMS-TTS Telugu (modal deploy modal/mms_tts.py). The deploy prints the URL.
# No other voice provider exists: every model Concourse calls at runtime is a Meta model.
TTS_BASE_URL=
TTS_TOKEN=
TTS_SPEAKER=0
# Cached notes live in data/tts-cache/s<speaker>; leave empty for that default
TTS_CACHE_DIR=

# The tape (judge path). record = save every model input/output of a real run under TAPE_DIR;
# replay = serve those recordings, so the demo runs without MODEL_API_KEY, TTS_BASE_URL or WhatsApp. off = normal.
TAPE_MODE=off
TAPE_DIR=eval/sample-run

# Optional flight status (demo uses a simulated event)
AEROAPI_KEY=

# Service
# Leave empty for the built-in file DB (./data/concourse, survives restarts). Production: jdbc:postgresql://host:5432/concourse
# Leave empty for a local H2 file DB. Hosted: paste the host's Postgres URL as-is (postgresql://user:pass@host:port/db) — it is converted to JDBC for you.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
PUBLIC_BASE_URL=
ADMIN_TOKEN=
PHONE_HASH_SALT=
FFMPEG_PATH=ffmpeg
# true while testing with old tickets; false in production
ITINERARY_ALLOW_PAST_DATES=true

# Meta Model API (dev.meta.ai) — Spark + Voice Transcribe
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
STT_MODEL=muse-voice-transcribe-1.0

# WhatsApp Business Cloud API (developers.facebook.com → app → WhatsApp → Step 1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v25.0

# Text-to-speech: facebook/mms-tts-tel on Modal (modal deploy modal/mms_tts.py prints the URL)
TTS_BASE_URL=
TTS_TOKEN=
TTS_CACHE_DIR=data/tts-cache
# SeamlessM4T option (modal deploy modal/seamless_tts.py): point TTS_BASE_URL at it and pick a speaker 0-199
TTS_SPEAKER=0

# Fallback TTS (Google Chirp 3 HD te-IN) — only if MMS fails the intelligibility test.
# Set TTS_PROVIDER=google and an API key from a GCP project with the Text-to-Speech API enabled.
TTS_PROVIDER=mms
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=te-IN-Chirp3-HD-Aoede

# Optional flight status (demo uses a simulated event)
AEROAPI_KEY=

# Service
# Leave empty for the built-in file DB (./data/concourse, survives restarts). Production: jdbc:postgresql://host:5432/concourse
# Leave empty for a local H2 file DB. Hosted: paste the host's Postgres URL as-is (postgresql://user:pass@host:port/db) — it is converted to JDBC for you.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
PUBLIC_BASE_URL=
ADMIN_TOKEN=
PHONE_HASH_SALT=
FFMPEG_PATH=ffmpeg
# true while testing with old tickets; false in production
ITINERARY_ALLOW_PAST_DATES=true
